[Unit]
Description=Behavior Box Device Controller
Documentation=https://github.com/henryburgess/bbox_controller
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/pi/bbox_controller
ExecStart=/home/pi/bbox_controller/venvs/device/bin/python /home/pi/bbox_controller/packages/device/main.py
Restart=always
RestartSec=10
StandardOutput=append:/home/pi/bbox_controller/apps/device/logs/device.log
StandardError=append:/home/pi/bbox_controller/apps/device/logs/device.log

# Security hardening (optional)
NoNewPrivileges=false
PrivateTmp=true

[Install]
WantedBy=multi-user.target
